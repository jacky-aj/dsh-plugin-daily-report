{
  "name": "dsh-plugin-daily-report",
  "version": "1.1.1",
  "description": "月底不知道干了哪些活？自动汇总多个 Git 仓库、分支与本地文档，AI 分析并导出 XLSX/Markdown/CSV/HTML 日报。",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/**/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "docs/**/*.md",
    "client-locale/*.json"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "keywords": [
    "dsh",
    "daily-report",
    "git",
    "xlsx",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://gitee.com/yuanjiegit/dsh-plugin-daily-report"
  },
  "homepage": "https://gitee.com/yuanjiegit/dsh-plugin-daily-report#readme",
  "bugs": {
    "url": "https://gitee.com/yuanjiegit/dsh-plugin-daily-report/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.0",
    "react": "^19.3.1",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepublishOnly": "npm run build",
    "lint": "eslint client.js index.js lib/**/*.js",
    "test": "vitest run",
    "check": "npm run build && npm run lint && npm run coverage:vitest",
    "test:coverage": "vitest run --coverage",
    "test:vitest": "vitest run",
    "coverage:vitest": "vitest run --coverage"
  }
}
